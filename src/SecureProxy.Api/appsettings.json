{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "ProxyDb": "Server=(localdb)\\MSSQLLocalDB;Database=SecureProxy;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Proxy": {
    "MaxRequestBytes": 1048576,
    "ConfigCacheSeconds": 30,
    "MaxConnectionsPerServer": 64,
    "AllowPrivateNetworkDestinations": false
  }
}
